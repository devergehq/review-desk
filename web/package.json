{
  "name": "review-desk-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "types:contract": "openapi-typescript ../contract/openapi.yaml -o app/types/contract.ts",
    "e2e": "pnpm run e2e:build && playwright test --config e2e/playwright.config.ts --project desk",
    "e2e:screenshots": "pnpm run e2e:build && playwright test --config e2e/playwright.config.ts --project screenshots",
    "e2e:build": "nuxt generate && cargo build --manifest-path ../Cargo.toml"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "dompurify": "^3.4.16",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.1.0",
    "nuxt": "^4.6.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.64.0",
    "@types/markdown-it": "^14.2.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
