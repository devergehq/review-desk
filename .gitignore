target/
.DS_Store

# Tooling for the contract checks (contract/package.json pins the versions).
contract/node_modules/

# Python's bytecode cache for the dependency checks in tools/. Generated, so not committed;
# the checks themselves write no report and no cache of their own -- `release_age.py`
# prints its table and keeps nothing.
__pycache__/

# The design loop's own working directory: a copy of
# ~/.locus/data/review-desk/design-loop/fixture.db, and the before/after screenshots
# `web/scripts/shoot.mjs` writes. The copy is there so the snapshot stays a clean baseline
# to reset from, and the pictures are published in an artifact rather than committed --
# `docs/screenshots/` is the committed set and is produced by `e2e/screenshots.spec.ts`.
.design-loop/
