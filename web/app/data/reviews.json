    "brief": {
      "review_id": 16,
      "problem": "Every request re-reads the permission table. The ticket asks for a cache, and round 1 asked what happens to a cached entry when a permission is revoked.",
      "diagram": "BEFORE (shared surface, implicit flow record)\n\nconsumer app --> GET /oauth/authorize --(guest)--> redirect()->guest() writes url.intended\n    |\n    v\nGET /login  (SHARED staff page)\n    |\n    FortifyServiceProvider reads url.intended",
      "options": [
        {
          "key": "A",
          "title": "Time-to-live only",
          "argument_for": "Nothing to invalidate; no bust path to get wrong.",
          "argument_against": "A revoke takes up to the whole window to take effect.",
          "chosen": false
        },
        {
          "key": "B",
          "title": "Time-to-live and an explicit bust",
          "argument_for": "A revoke takes effect at once and the window bounds the damage.",
          "argument_against": "The bust has to name every key the permission reaches.",
          "chosen": true
        }
      ],
      "approach_verdict": "A short time-to-live plus an explicit bust on revoke. Round 2 adds the bust.",
      "provenance": "carried from round 1 · you confirmed it then",
