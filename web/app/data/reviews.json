    "brief": {
      "review_id": 12,
      "problem": "The nightly export runs as one job and times out once the largest tenant passes a million rows. The ticket asks for it to be split.",
      "diagram": null,
      "options": [
        {
          "key": "A",
          "title": "One job, a longer timeout",
          "argument_for": "No new moving parts.",
          "argument_against": "The timeout grows with the largest tenant, for ever.",
          "chosen": false
        },
        {
          "key": "B",
          "title": "One job per tenant, with a cursor",
          "argument_for": "Each job is small and a failure is contained to one tenant.",
          "argument_against": "Needs somewhere to keep the cursor.",
          "chosen": true
        },
