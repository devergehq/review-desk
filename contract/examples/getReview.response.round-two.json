  "brief": {
    "review_id": 20,
    "problem": "When a customer's endpoint is down, a webhook delivery fails once and is never tried again. The customer finds out only when their own records drift. The ticket asks for deliveries to be retried for up to 24 hours and for the customer to see which ones failed.",
    "diagram": "flowchart LR\n  A[Event happens<br/>Delivery is sent inline] --> B[Endpoint is down<br/>Error is logged, nothing stored]\n  B --> C[Delivery is lost<br/>No retry, no record, no notice]",
    "options": [
      {
        "key": "A",
        "title": "Retry inside the request",
        "argument_for": "Smallest change, no new tables.",
        "argument_against": "Holds the user's request open; cannot span 24 hours.",
        "chosen": false
      },
      {
        "key": "B",
        "title": "Queue with backoff",
        "argument_for": "Meets the 24-hour window; failures are stored and visible.",
        "argument_against": "Needs an idempotency key so a retry is not a duplicate.",
        "chosen": true
      },
      {
        "key": "C",
        "title": "Dead-letter and manual replay",
        "argument_for": "A person can replay one delivery after fixing an endpoint.",
        "argument_against": "Nothing happens automatically.",
        "chosen": false
      }
    ],
    "approach_verdict": "B is the right shape for this ticket. It leaves out the one useful part of C: once the 24 hours run out there is no way to replay a delivery by hand. That is finding F2.",
    "provenance": "from the ticket and the code \u00b7 you corrected one sentence",
    "confirmed": true,
    "confirmed_at": "2026-10-08T10:58:00Z",
    "confirmation_required": true,
